# Optional settings. Copy this file to .env and remove the # from any line you want.
# Everything here except APP_PASSWORD, PORT and HOST can also be changed later on
# Edit > Edit platform, and what you set there wins over this file.

# Shared password. Leave unset to choose one on the first visit (the app prints a
# one-time setup code in its window). If set, it overrides a password chosen that way.
# APP_PASSWORD=choose-a-strong-one

# Port to listen on (default 8080).
# PORT=8080

# Listen on this address only. 127.0.0.1 = this computer only (enough for a Cloudflare
# tunnel). Unset = every network interface, so other computers can open the board.
# HOST=127.0.0.1

# Starting values for Edit platform.
# EXERCISE_NAME=My Exercise
# UNIT_NAME=Enclave
# ENCLAVES=Enclave 1,Enclave 2,Enclave 3,Enclave 4
# EXERCISE_DAY1_DATE=2027-03-01
# TIMEZONE=America/New_York

# The Windows .exe opens your browser when it starts; set this to stop that.
# NO_BROWSER=1

# Advanced: fixed cookie-signing secret (default: random, kept in data/).
# SESSION_SECRET=
